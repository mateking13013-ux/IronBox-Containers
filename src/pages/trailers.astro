---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCategories, getAllProducts, formatPrice, getProductCondition } from '../lib/woocommerce.js';

const trailerSlugs = ['utility-trailers', 'livestock-trailers', 'flatbed-trailers'];
const allCategories = await getCategories();
const trailerCategories = allCategories.filter(c => trailerSlugs.includes(c.slug));
const allProducts = await getAllProducts({ per_page: 500 });
const trailers = allProducts.filter(p =>
  p.categories.some(c => trailerSlugs.includes(c.slug))
);

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Trailers — Utility, Livestock & Flatbed",
  "description": "Browse our complete trailer inventory: utility, livestock, and flatbed trailers from East Texas Trailers, PJ Trailers, Gooseneck, Friesen, Dura-Haul, and W-W. Nationwide delivery from Decatur, Texas.",
  "url": "https://ironboxcontainers.com/trailers",
  "breadcrumb": {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://ironboxcontainers.com" },
      { "@type": "ListItem", "position": 2, "name": "Trailers", "item": "https://ironboxcontainers.com/trailers" }
    ]
  }
};
---

<MainLayout
  title="Trailers — Utility, Livestock & Flatbed Trailers | IronBox"
  description={`Browse all ${trailers.length} trailers in stock: utility, livestock, and flatbed. New & used. Nationwide delivery from Decatur, Texas.`}
>
  <slot slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(collectionSchema)}></script>
  </slot>
  <Header />
  <main class="min-h-screen bg-gray-50">

    <!-- Hero -->
    <section class="bg-gradient-to-br from-gray-900 to-gray-700 text-white">
      <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8 lg:py-20">
        <nav class="mb-4 text-xs text-gray-300">
          <a href="/" class="hover:text-white">Home</a>
          <span class="mx-1.5">/</span>
          <span class="text-white">Trailers</span>
        </nav>
        <h1 class="text-3xl font-extrabold sm:text-5xl">Trailers — All In Stock, Ready to Roll</h1>
        <p class="mt-4 max-w-2xl text-base text-gray-200 sm:text-lg">
          {trailers.length} utility, livestock, and flatbed trailers from East Texas Trailers, PJ Trailers, Gooseneck, Friesen, Dura-Haul, and W-W. Inspected, priced in USD, and delivered nationwide from our Decatur, Texas yard.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-3">
          {trailerCategories.map((cat) => (
            <a
              href={`/categories/${cat.slug}`}
              class="rounded-lg bg-white/10 px-4 py-2 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
            >
              {cat.name} <span class="text-white/60">({cat.count})</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Category cards -->
    <section class="border-b bg-white">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-gray-900">Shop by category</h2>
        <div class="mt-5 grid gap-4 sm:grid-cols-3">
          {trailerCategories.map((cat) => (
            <a href={`/categories/${cat.slug}`} class="group block overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:shadow-lg">
              <div class="aspect-[4/3] overflow-hidden bg-gray-100">
                {cat.image?.src && (
                  <img src={cat.image.src} alt={cat.name} class="h-full w-full object-cover transition group-hover:scale-105" loading="eager" decoding="async" />
                )}
              </div>
              <div class="p-4">
                <div class="flex items-center justify-between">
                  <h3 class="text-base font-bold text-gray-900 group-hover:text-blue-600">{cat.name}</h3>
                  <span class="rounded-full bg-blue-50 px-2.5 py-0.5 text-xs font-semibold text-blue-700">{cat.count} in stock</span>
                </div>
                <p class="mt-1 text-sm text-gray-600 line-clamp-2">{cat.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- All trailers -->
    <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
      <div class="mb-6 flex items-end justify-between">
        <h2 class="text-xl font-bold text-gray-900">All Trailers <span class="ml-1 text-sm font-normal text-gray-500">({trailers.length})</span></h2>
      </div>

      {trailers.length > 0 ? (
        <div class="grid grid-cols-2 gap-3 sm:gap-4 md:grid-cols-3 xl:grid-cols-4">
          {trailers.map((product) => {
            const condition = getProductCondition(product);
            const imageUrl = product.images?.[0]?.src || 'https://via.placeholder.com/400x300';
            const catName = product.categories[0]?.name || 'Trailer';
            return (
              <a href={`/products/${product.slug}`} class="group">
                <div class="overflow-hidden rounded-xl border border-gray-100 bg-white transition-all duration-200 hover:border-gray-200 hover:shadow-md">
                  <div class="relative aspect-square overflow-hidden bg-gray-50">
                    <img src={imageUrl} alt={product.name} class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105" loading="eager" decoding="async" />
                    <div class="absolute inset-x-0 top-0 flex items-start justify-between p-2">
                      <span class={`rounded-md px-2 py-0.5 text-[10px] font-semibold backdrop-blur-sm ${condition === 'New' ? 'bg-emerald-500/90 text-white' : 'bg-amber-500/90 text-white'}`}>{condition}</span>
                      <span class="rounded-md bg-black/60 px-2 py-0.5 text-[10px] font-semibold text-white backdrop-blur-sm">{catName.replace(' Trailers','')}</span>
                    </div>
                  </div>
                  <div class="p-3">
                    <h3 class="line-clamp-2 text-xs font-medium leading-snug text-gray-900 transition-colors group-hover:text-blue-600 sm:text-sm">{product.name}</h3>
                    <div class="mt-2">
                      <span class="text-sm font-bold text-gray-900 sm:text-base">{formatPrice(product.price)}</span>
                    </div>
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      ) : (
        <div class="rounded-lg border border-gray-200 bg-white p-12 text-center">
          <h3 class="text-lg font-semibold text-gray-900">No trailers found</h3>
          <p class="mt-2 text-gray-600">Please check back soon or contact us at +1 816 255 7461.</p>
        </div>
      )}
    </section>

  </main>
  <Footer />
</MainLayout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
